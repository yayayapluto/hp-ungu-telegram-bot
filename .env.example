# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
# Comma-separated numeric Telegram user IDs allowed to use the bot.
TELEGRAM_ADMIN_IDS=100000001

# ---------------------------------------------------------------------------
# Ubuntu application
# ---------------------------------------------------------------------------
DEFAULT_WORKING_DIRECTORY=/root
COMMAND_TIMEOUT_SECONDS=120
MAX_CONCURRENT_JOBS=3
MAX_OUTPUT_BYTES=262144
MAX_READ_BYTES=1048576
MAX_UPLOAD_BYTES=20971520
PROGRESS_INTERVAL_SECONDS=5

# Master switch for shell mode (/sh). Per-admin toggle lives in /settings.
ENABLE_UNRESTRICTED_SHELL=false

# ':'-separated absolute roots the file manager may touch.
ALLOWED_FILE_ROOTS=/root:/tmp

# ---------------------------------------------------------------------------
# Native Termux bridge
# ---------------------------------------------------------------------------
TERMUX_BRIDGE_HOST=127.0.0.1
TERMUX_BRIDGE_PORT=8765
TERMUX_BRIDGE_TOKEN=REPLACE_WITH_GENERATED_TOKEN
TERMUX_BRIDGE_TIMEOUT_SECONDS=60
TERMUX_BRIDGE_MAX_IMAGE_BYTES=5242880

# ---------------------------------------------------------------------------
# SSH / Tailscale (initial values, verifiable via /sshstatus)
# ---------------------------------------------------------------------------
SSH_HOSTNAME=CHANGE_ME.tailXXXXXX.ts.net
SSH_PORT=8022
SSH_USERNAME=CHANGE_ME_TERMUX_USER
TAILSCALE_IP=100.64.0.0

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
